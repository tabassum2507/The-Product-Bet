---
import { getCoverVars, getTagIcon } from '../lib/cover';

interface Props {
  seed: string;
  tags: string[];
  class?: string;
}

const { seed, tags, class: className } = Astro.props;
const { angle, from, to } = getCoverVars(seed);
const icon = getTagIcon(tags);
const style = `--cover-angle:${angle}deg;--cover-from:${from}%;--cover-to:${to}%;`;
---

<div class:list={['cover', className]} style={style} aria-hidden="true">
  <svg class="cover-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    {icon === 'rag' && (
      <>
        <ellipse cx="12" cy="5" rx="8" ry="3" />
        <path d="M4 5v6c0 1.66 3.58 3 8 3s8-1.34 8-3V5" />
        <path d="M4 11v6c0 1.66 3.58 3 8 3s8-1.34 8-3v-6" />
      </>
    )}
    {icon === 'voice' && (
      <>
        <rect x="9" y="2" width="6" height="12" rx="3" />
        <path d="M5 10a7 7 0 0 0 14 0" />
        <path d="M12 17v4M8 21h8" />
      </>
    )}
    {icon === 'agentic' && (
      <>
        <circle cx="5" cy="6" r="2.5" />
        <circle cx="19" cy="6" r="2.5" />
        <circle cx="12" cy="18" r="2.5" />
        <path d="M7 7.5 10 16M17 7.5 14 16M7.5 6h9" />
      </>
    )}
    {icon === 'pm' && (
      <>
        <circle cx="12" cy="12" r="8" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="12" cy="12" r="0.5" fill="currentColor" />
      </>
    )}
    {icon === 'default' && (
      <path d="M12 3v4M12 17v4M3 12h4M17 12h4M5.6 5.6l2.8 2.8M15.6 15.6l2.8 2.8M18.4 5.6l-2.8 2.8M8.4 15.6l-2.8 2.8" />
    )}
  </svg>
</div>
