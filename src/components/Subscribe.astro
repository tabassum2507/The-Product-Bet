---
const SUBSCRIBE_ACTION = 'https://buttondown.com/api/emails/embed-subscribe/khanum';
---

<section class="newsletter-band">
  <div class="wrap newsletter-inner">
    <h2>Subscribe to the newsletter</h2>
    <p>Get new articles and TIL notes in your inbox.</p>
    <form class="newsletter-form" action={SUBSCRIBE_ACTION} method="POST" target="_blank">
      <input type="email" name="email" placeholder="Your email address" aria-label="Email address" required />
      <button type="submit">Subscribe</button>
    </form>
    <p class="newsletter-fineprint">One post a week. Unsubscribe anytime.</p>
  </div>
</section>
